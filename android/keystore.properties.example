# Copy this file to `keystore.properties` (which is gitignored) and fill in real values.
# Generate an upload keystore with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Android TV HA Bridge, O=Josh McNabb, C=NZ"
# With Google Play App Signing, this is only the UPLOAD key — losing it is recoverable,
# but back it up anyway. Paths are relative to the android/ (gradle root) directory.
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
